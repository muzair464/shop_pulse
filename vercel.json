{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist/shoppulse-frontend/browser",
  "framework": "angular",
  "routes": [
    {
      "src": "^/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "^/(.*\\.js|.*\\.css|.*\\.ico|.*\\.svg|.*\\.png|.*\\.woff2?|.*\\.ttf)",
      "dest": "/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
